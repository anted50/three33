# =============================================================================
# Environment reference — every variable the code reads, and nothing else.
#
#   cp .env.example .env
#
# Values here are MOCKS. They are shaped to pass validation so a fresh clone
# boots, not to work against any real service. Validation lives in
# src/lib/server/env.ts (server) — boot fails with a list of what is wrong.
#
# Layout:
#   KEY=value     required, or has an effect when set — mock filled in
#   # KEY=value   optional; leave commented unless you need it. Some of these
#                 switch a feature ON when set (StorePay, Resend, e-barimt),
#                 so a mock value there would break that feature instead of
#                 leaving it off.
#
# Note: a blank `KEY=` line counts as unset only for optional variables.
# =============================================================================


# ---- App --------------------------------------------------------------------
# development | test | production. Production enables Secure cookies and
# refuses to run on PGlite.
NODE_ENV=development
# Public base URL. Builds payment callback URLs and links in e-mails, so in a
# deployed environment it must be the real domain.
APP_URL=http://localhost:3000
# Port for the production server (npm start). Railway injects it; `vite dev`
# ignores it and uses 3000.
# PORT=3000


# ---- Database ---------------------------------------------------------------
# postgres (via DATABASE_URL) or pglite (in-process, no Docker needed).
# Defaults to postgres when DATABASE_URL is set, pglite otherwise.
# DB_DRIVER=postgres
# Matches docker-compose.yml. Comment out to use PGlite instead.
DATABASE_URL=postgres://uppercut:uppercut@localhost:5432/uppercut
# PGlite's data directory, when DB_DRIVER=pglite. Gitignored.
# PGLITE_DIR=.pglite


# ---- QPay (required) --------------------------------------------------------
# QPay issued this merchant PRODUCTION credentials only — there is no sandbox.
# Every invoice created against real credentials is real and payable. With the
# mocks below the app boots, but creating or checking a QPay invoice fails.
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=MOCK_QPAY_USERNAME
QPAY_PASSWORD=mock-qpay-password
QPAY_INVOICE_CODE=MOCK_QPAY_INVOICE
# HMAC key that signs our callback URLs. Ours, not QPay's. At least 32 chars:
#   openssl rand -base64 48
QPAY_CALLBACK_SECRET=mock-qpay-callback-secret-0123456789abcdef


# ---- QPay e-barimt (optional) -----------------------------------------------
# VAT-enabled invoice code, separate from QPAY_INVOICE_CODE — request it from
# QPay. Unset skips the e-barimt receipt; the order receipt e-mail still sends.
# QPAY_EBARIMT_INVOICE_CODE=MOCK_QPAY_EBARIMT_INVOICE


# ---- StorePay (optional, all-or-nothing) -----------------------------------
# Installment checkout option next to QPay. Offered at checkout only when ALL
# seven are set — leave the block commented to keep it hidden.
# STOREPAY_BASE_URL=https://service.storepay.mn/lend-merchant
# Client (app) credentials — HTTP Basic on /oauth/token.
# STOREPAY_APP_USERNAME=mock-storepay-app-user
# STOREPAY_APP_PASSWORD=mock-storepay-app-password
# Resource-owner credentials StorePay issued this merchant (password grant).
# STOREPAY_USERNAME=mock-storepay-user
# STOREPAY_PASSWORD=mock-storepay-password
# This shop's StorePay store number.
# STOREPAY_STORE_ID=0000
# HMAC key for StorePay callback URLs, at least 32 chars. Generate its own.
# STOREPAY_CALLBACK_SECRET=mock-storepay-callback-secret-0123456789abcdef


# ---- E-mail (Resend) --------------------------------------------------------
# Order receipts and admin login codes. Unset skips sending — in development
# the admin login code is printed to the server console instead. A set but
# invalid key makes sending FAIL, so leave it commented until you have a real
# `re_...` key.
# RESEND_API_KEY=re_mock_0000000000000000000000
# Must be on a domain verified in Resend once sending is on.
EMAIL_FROM="Three33 Barbershop <noreply@example.com>"


# ---- PostHog ----------------------------------------------------------------
# Product analytics (browser) and server logs. Both REQUIRED in development —
# the app throws if either is missing; in production missing just disables it.
# VITE_ means it is also baked into the client bundle at build time: public
# values only.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_mock0000000000000000000000000000000000
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# ---- Scheduled jobs ---------------------------------------------------------
# Bearer token for POST /api/v1/jobs/{reconcile,booking-sweep,cleanup}, so an
# external scheduler can trigger them. Unset disables those endpoints (503).
# At least 32 chars: openssl rand -hex 32
# JOBS_API_TOKEN=mock-jobs-api-token-0123456789abcdef
# The server also runs the jobs on its own timers unless this is "off". Only
# turn them off once an external scheduler is calling the endpoints above.
# SCHEDULED_JOBS=off
# See docs/scheduled-jobs.md.


# ---- Admin dashboard --------------------------------------------------------
# Monthly order target shown on /admin. Defaults to 100.
# MONTHLY_ORDER_GOAL=100
#
# Admin login itself needs no variable: it is e-mail OTP against
# users.role = 'admin'. Grant it with:
#   npm run admin:add you@example.mn "Your Name"
