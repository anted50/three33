# ---- App ----
NODE_ENV=development
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-string

# ---- Database ----
# Matches docker-compose.yml defaults
DATABASE_URL=postgres://uppercut:uppercut@localhost:5432/uppercut

# ---- Object storage (MinIO in dev, S3-compatible in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=uppercut-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO needs path-style; most cloud S3 does not
S3_FORCE_PATH_STYLE=true
# Public base URL images are served from
S3_PUBLIC_URL=http://localhost:9000/uppercut-media

# ---- QPay ----
# Sandbox first. Request merchant credentials in week 1.
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# HMAC key used to sign the ?t= token on our callback URL. Independent of QPay.
QPAY_CALLBACK_SECRET=replace-me-with-a-long-random-string

# ---- Email ----
RESEND_API_KEY=
EMAIL_FROM="Uppercut Deluxe Mongolia <noreply@example.mn>"

# ---- Shipping (mungu: tugrik x 100) ----
SHIPPING_FEE_UB=500000
SHIPPING_FEE_COUNTRYSIDE=1500000

# ---- Observability ----
SENTRY_DSN=
