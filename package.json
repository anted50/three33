{
  "name": "uppercut-mn",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:lan": "vite dev --host",
    "build": "node scripts/build.mjs",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "node scripts/build.mjs --env staging && wrangler deploy",
    "cf-typegen": "wrangler types --env-file .env.example",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:d1": "vitest run --project d1",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --import ./scripts/lib/register.mjs scripts/seed.ts",
    "admin:add": "tsx scripts/add-admin.ts",
    "import:railway": "tsx scripts/import-railway.ts",
    "order:inspect": "tsx --import ./scripts/lib/register.mjs scripts/order-inspect.ts",
    "job": "tsx scripts/run-job.ts",
    "qpay:ping": "tsx --import ./scripts/lib/register.mjs scripts/qpay-ping.ts",
    "qpay:smoke": "tsx --import ./scripts/lib/register.mjs scripts/qpay-smoke.ts",
    "storepay:ping": "tsx --import ./scripts/lib/register.mjs scripts/storepay-ping.ts",
    "mail:preview": "tsx --import ./scripts/lib/register.mjs scripts/preview-email.ts"
  },
  "dependencies": {
    "@posthog/react": "^1.11.3",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.34",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "sharp": "^0.35.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
