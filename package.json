{
  "name": "uppercut-mn",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:lan": "vite dev --host",
    "build": "node scripts/build.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "qpay:ping": "tsx scripts/qpay-ping.ts",
    "qpay:smoke": "tsx scripts/qpay-smoke.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@hono/node-server": "^2.1.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.34",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^7.1.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
