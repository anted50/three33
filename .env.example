# ---- App ----
NODE_ENV=development
APP_URL=http://localhost:3000

# ---- Database ----
# Matches docker-compose.yml defaults
DATABASE_URL=postgres://uppercut:uppercut@localhost:5432/uppercut

# ---- QPay ----
# QPay issued this merchant PRODUCTION credentials only — there is no sandbox
# pair. Every invoice created against these is real and payable. See README.
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# HMAC key used to sign the ?t= token on our callback URL. Independent of QPay.
QPAY_CALLBACK_SECRET=replace-me-with-a-long-random-string

# ---- StorePay ----
# Installment checkout option, alongside QPay above. Leave the whole block
# unset to keep it out of checkout — see src/lib/server/env.ts.
STOREPAY_BASE_URL=https://service.storepay.mn/lend-merchant
# Client (app) credentials — HTTP Basic on /oauth/token.
STOREPAY_APP_USERNAME=
STOREPAY_APP_PASSWORD=
# Resource-owner credentials StorePay issued this merchant (password grant).
STOREPAY_USERNAME=
STOREPAY_PASSWORD=
# This shop's StorePay store number.
STOREPAY_STORE_ID=
# HMAC key used to sign the ?t= token on our callback URL. Independent of the
# above; generate its own long random string, same as QPAY_CALLBACK_SECRET.
STOREPAY_CALLBACK_SECRET=

# ---- Email ----
# Resend API key ("re_..."), for order receipts and admin login codes.
# Unset skips sending. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Three33 Barbershop <noreply@three33barber.com>"

# Preview the receipt template without sending anything:
#   npm run mail:preview
# Then open receipt-preview.html and toggle your OS light/dark setting — the
# template is light-only by declaration, see src/lib/server/email/shell.ts.

# ---- E-barimt ----
# VAT-enabled QPay invoice code, separate from QPAY_INVOICE_CODE above.
# Request this from QPay — the plain invoice code cannot issue receipts.
# Unset skips the e-barimt call; the receipt email still sends without it.
QPAY_EBARIMT_INVOICE_CODE=

# ---- Observability ----
SENTRY_DSN=

# ---- Admin ----
# No env var to set here. Admin login is email OTP (see
# src/lib/server/admin/auth.ts) against users.role = 'admin' — grant it with:
#   npm run admin:add you@example.mn "Your Name"
# Sending the code requires RESEND_API_KEY above.
