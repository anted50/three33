/**
 * Cloudflare Workers deployment.
 *
 *   npm run deploy        build + wrangler deploy
 *   npm run cf-typegen    regenerate worker-configuration.d.ts after editing this
 *
 * Secrets (QPAY_PASSWORD, JOBS_API_TOKEN, …) are NOT in this file — set them
 * with `npx wrangler secret put <NAME>`. Locally they come from .dev.vars (or
 * .env when there is no .dev.vars). The full list is .env.example.
 * See docs/deploy-cloudflare.md.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "three33",
  // Must not be newer than the installed workerd (npx workerd --version).
  "compatibility_date": "2026-10-01",
  // node:crypto, Buffer, process.env from bindings — the server code uses all three.
  "compatibility_flags": ["nodejs_compat"],

  // TanStack Start's fetch handler plus the cron handler — see src/server.ts.
  "main": "src/server.ts",

  "observability": { "enabled": true },

  // Served on https://three33.uppercut-mn.workers.dev — the temporary address
  // until three33barber.com is attached (then update APP_URL below too).
  "workers_dev": true,

  /**
   * Scheduled jobs. Each expression maps to one job in CRON_JOBS in
   * src/server.ts — the two must be edited together. All times are UTC.
   * Every job is also callable at POST /api/v1/jobs/<name>.
   */
  "triggers": {
    "crons": [
      "*/5 * * * *", // booking-sweep: unpaid holds block real slots, so often
      "7 * * * *",   // reconcile: hourly net under the payment callbacks
      "17 19 * * *"  // cleanup: 03:17 Ulaanbaatar, when the shop is closed
    ]
  },

  /**
   * The database. Code reaches it as `env.DB` (src/db/index.ts). Locally,
   * wrangler keeps a SQLite file under .wrangler/state instead.
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "three33",
      "database_id": "3106b8b7-fe3e-4422-81ee-dcf8d4c65423",
      "migrations_dir": "drizzle"
    }
  ],

  /**
   * Non-secret configuration. VITE_PUBLIC_* are NOT read from here for the
   * browser — Vite bakes them into the client bundle at build time from the
   * build machine's environment / .env.
   */
  "vars": {
    "NODE_ENV": "production",
    "APP_URL": "https://three33.uppercut-mn.workers.dev",
    "QPAY_BASE_URL": "https://merchant.qpay.mn/v2",
    "EMAIL_FROM": "Three33 Barbershop <noreply@three33barber.com>"
  },

  /**
   * Staging: a second Worker (three33-staging) for trying changes on
   * Cloudflare before they reach production.
   *
   *   npm run deploy:staging            build for staging + deploy
   *   npx wrangler secret put NAME --env staging
   *
   * Build with CLOUDFLARE_ENV=staging (deploy:staging does this): the Vite
   * plugin flattens this block into the deployed config at build time, so
   * `wrangler deploy --env staging` on its own does not switch environments.
   *
   * Keys like vars, d1_databases and triggers are not inherited from the
   * top level — everything staging needs is spelled out here.
   */
  "env": {
    "staging": {
      "name": "three33-staging",
      "vars": {
        "NODE_ENV": "production",
        "APP_URL": "https://three33-staging.uppercut-mn.workers.dev",
        "QPAY_BASE_URL": "https://merchant.qpay.mn/v2",
        "EMAIL_FROM": "Three33 Barbershop <noreply@three33barber.com>"
      },
      /**
       * FOR NOW the PRODUCTION database — on purpose, while production is
       * still empty. Everything staging writes is real production data, and
       * `npm run db:migrate:staging` migrates production. To give staging
       * its own data: `npx wrangler d1 create three33-staging`, put the new
       * id here, and run `npm run db:migrate:staging`.
       */
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "three33",
          "database_id": "3106b8b7-fe3e-4422-81ee-dcf8d4c65423",
          "migrations_dir": "drizzle"
        }
      ],
      // No crons: production's already sweep the shared database, and two
      // sets would only double the QPay checks. Trigger a job by hand with
      // `npm run job -- <name> --url <staging url>` if needed.
      "triggers": { "crons": [] }
    }
  }
}
